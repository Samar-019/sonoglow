{
  "name": "sonoglow-player",
  "productName": "Sonoglow",
  "version": "0.1.0",
  "private": true,
  "description": "An unpacked Windows YouTube music player with an immersive desktop view.",
  "homepage": "https://samar-019.github.io/sonoglow/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Samar-019/sonoglow.git"
  },
  "bugs": {
    "url": "https://github.com/Samar-019/sonoglow/issues"
  },
  "author": "Samar-019 <i.axis.019@gmail.com>",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node src/preview.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.samar019.sonoglow",
    "productName": "Sonoglow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "ui/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sonoglow",
      "artifactName": "Sonoglow-Setup.${ext}"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "lucide": "0.577.0",
    "youtubei.js": "18.3.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "gifenc": "^1.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
